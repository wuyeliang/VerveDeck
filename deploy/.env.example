# VerveDeck 平台环境变量（复制到 deploy/.env 使用：cp .env.example .env）
# 注：deploy.sh 首启会自动生成强随机密钥写入 .env；手工部署时务必把下列弱默认值全部改掉。
# 公网部署完整清单见 docs/11-安全加固.md

# ===== 认证 =====
# admin 初始密码（首登强制修改）；公网部署用 12+ 位随机串
ADMIN_PASSWORD=admin123
# JWT 签名密钥：必须改为 32+ 字节随机串（openssl rand -hex 32）——弱密钥=任何人可伪造登录 token
JWT_SECRET=please-change-me-to-a-long-random-string
# Postgres 密码
POSTGRES_PASSWORD=fintune123

# ===== 对象存储（rustfs，S3 兼容）=====
# S3 密钥；公网部署必须改（端口已绑 127.0.0.1，但内网/同机容器也要防滥用）
RUSTFS_ACCESS_KEY=vervedeck
RUSTFS_SECRET_KEY=rustfsadmin
# 数据集版本文件的主存储端点；留空（S3_ENDPOINT=）则关闭对象存储、纯本地 /data
S3_ENDPOINT=http://rustfs:9000
# 数据集桶名
S3_BUCKET=vervedeck-datasets

# ===== HuggingFace =====
# 国内网络建议走 HF 镜像；直连可改为 https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ===== Argilla 数据标注 =====
ARGILLA_API_KEY=fintune-argilla-key

# ===== Grafana（监控大屏）=====
# Grafana admin 密码（默认仅本机 127.0.0.1:3000 可达，公网经平台 /grafana/ 代理）
GRAFANA_PASSWORD=vervedeck-grafana
# 匿名只读访问（平台监控大屏 iframe 免登录）；公网部署可设 false 关闭
GRAFANA_ANONYMOUS=true

# ===== 后端安全（公网部署建议收紧）=====
# Alertmanager 内部 webhook 回调令牌（防公网伪造回调）
AM_WEBHOOK_TOKEN=
# CORS 允许来源，逗号分隔；公网部署建议写实际访问域名（如 https://gpu.example.com）
CORS_ORIGINS=*
# 关闭 /docs 与 /openapi.json（防接口清单泄露）；公网部署建议 false
API_DOCS_ENABLED=true
